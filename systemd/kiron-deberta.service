[Unit]
Description=Kiron DeBERTa Cross-Encoder (Reranking / NLI)
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/kiron/services/kiron-deberta
ExecStart=/usr/lib/kiron/services/kiron-deberta/venv/bin/python main.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0

[Install]
WantedBy=multi-user.target
