[Unit]
Description=Kiron Proxy (Dashboard + Reverse Proxy + OpenAI API)
After=network.target docker.service mariadb.service
Wants=docker.service mariadb.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=kiron-proxy
Group=kiron-proxy
SupplementaryGroups=docker kiron-runtime kiron-common kiron-config kiron-prism-control
WorkingDirectory=/usr/lib/kiron/services/kiron-proxy
ExecStart=/usr/lib/kiron/services/kiron-proxy/venv/bin/python main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/kiron/dashboard.env
Environment=KIRON_RUNTIME_DIR=/run/kiron/vram
UMask=0027
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/lib/kiron/data/kiron-proxy /usr/lib/kiron/data/shared /run/kiron/vram /run/xtables.lock -/run/docker.sock -/var/run/docker.sock
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=false
PrivateDevices=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_NET_ADMIN
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
